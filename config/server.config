# ---------------------------------------------------------------
# Configuración del servidor de chat (ZeroC Ice 3.7)
# ---------------------------------------------------------------

# Escucha en todas las interfaces de red, puerto 10000
ChatAdapter.Endpoints=tcp -p 10000

# Tamaño máximo de un mensaje Ice en KB (por defecto 1024).
# Los archivos se envían en chunks de 64 KB, muy por debajo de este límite.
Ice.MessageSizeMax=2048

# Pool de hilos del servidor: las invocaciones se atienden en paralelo,
# por eso todo el estado compartido debe ser thread-safe.
Ice.ThreadPool.Server.Size=4
Ice.ThreadPool.Server.SizeMax=32

# ACM: si un cliente deja de enviar heartbeats durante este tiempo (segundos),
# el servidor cierra su conexión y se dispara la limpieza de la sesión.
Ice.ACM.Server.Timeout=15

# Advertencias útiles durante el desarrollo
Ice.Warn.Connections=1
Ice.Trace.Network=0
