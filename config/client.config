# ---------------------------------------------------------------
# Configuración del cliente de chat (ZeroC Ice 3.7)
# ---------------------------------------------------------------

# Los stubs se generan en el paquete co.edu.icesi.chat (metadato java:package
# en los .ice). Ice necesita esta propiedad para ubicar las clases de las
# excepciones Slice al recibirlas; sin ella llegan como UnknownUserException.
Ice.Package.chat=co.edu.icesi

# Proxy directo al servicio del servidor.
# Para otra máquina: ./gradlew runClient -Phost=<ip-servidor>
ChatService.Proxy=ChatService:tcp -h localhost -p 10000

Ice.MessageSizeMax=2048

# Los callbacks llegan por la misma conexión (bidireccional), así que debe
# mantenerse abierta aunque el usuario no escriba nada:
#  - Heartbeat=3 (HeartbeatAlways): el cliente envía latidos periódicos para
#    que el servidor sepa que sigue vivo.
#  - Close=0 (CloseOff): el cliente nunca cierra la conexión por inactividad.
#    Si el servidor se cae, el cierre de la conexión TCP lo avisa de inmediato.
Ice.ACM.Client.Timeout=15
Ice.ACM.Client.Heartbeat=3
Ice.ACM.Client.Close=0

# Hilos para despachar callbacks entrantes (mensajes, archivos, llamadas)
Ice.ThreadPool.Client.Size=2
Ice.ThreadPool.Client.SizeMax=8

# Poner en 1 para ver el detalle de las conexiones que se caen (depuración)
Ice.Warn.Connections=0
