# ---------------------------------------------------------------
# Configuración del servidor de chat (ZeroC Ice 3.7)
# ---------------------------------------------------------------

# Los stubs se generan en el paquete co.edu.icesi.chat (metadato java:package
# en los .ice). Ice necesita esta propiedad para ubicar las clases de las
# excepciones Slice al recibirlas; sin ella llegan como UnknownUserException.
Ice.Package.chat=co.edu.icesi

# Escucha en todas las interfaces de red, puerto 10000
ChatAdapter.Endpoints=tcp -p 10000

# Puerto UDP del relay de audio de las conferencias de voz (RF-06). El audio
# nunca pasa por Ice: los clientes lo envían aquí y el relay lo reenvía a los
# demás participantes de la sala. El firewall debe permitir UDP en este puerto.
AudioRelay.Port=10001

# Tamaño máximo de un mensaje Ice en KB (por defecto 1024).
# Los archivos se envían en chunks de 64 KB, muy por debajo de este límite.
Ice.MessageSizeMax=2048

# Pool de hilos del servidor: las invocaciones se atienden en paralelo,
# por eso todo el estado compartido debe ser thread-safe.
Ice.ThreadPool.Server.Size=4
Ice.ThreadPool.Server.SizeMax=32

# ACM (Active Connection Management): detección de clientes caídos.
#  - Close=4 (CloseOnIdleForceful): si en Timeout segundos no hay actividad en
#    la conexión, se cierra a la fuerza y se dispara la limpieza de la sesión
#    (ChatHub.connectionClosed). Los clientes vivos envían latidos, así que solo
#    se cierran las conexiones de clientes caídos o congelados.
#  - Heartbeat=0 (HeartbeatOff): el servidor NO envía latidos. Sus propios
#    latidos contarían como actividad y nunca vería la conexión inactiva.
Ice.ACM.Server.Timeout=15
Ice.ACM.Server.Heartbeat=0
Ice.ACM.Server.Close=4

# Poner en 1 para ver el detalle de cada conexión que se cae (depuración).
# El servidor ya registra cada LOGOUT con su causa.
Ice.Warn.Connections=0
